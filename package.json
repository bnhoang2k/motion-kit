{
  "name": "motion-kit",
  "version": "0.1.1",
  "description": "One set of motion numbers for Motion, three.js and Blender.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=26" },
  "bin": {
    "motion-kit": "./dist/src/cli/motion-kit.js",
    "motion-lab": "./dist/src/cli/motion-lab.js"
  },
  "exports": {
    ".": { "types": "./dist/src/core/index.d.ts", "default": "./dist/src/core/index.js" },
    "./motion": { "types": "./dist/src/motion/index.d.ts", "default": "./dist/src/motion/index.js" },
    "./three": { "types": "./dist/src/three/index.d.ts", "default": "./dist/src/three/index.js" },
    "./lab": { "types": "./dist/lab/moments/types.d.ts" }
  },
  "files": ["dist", "blender/*.py", "!blender/test_*.py"],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-lab-assets.mjs",
    "test": "vitest run",
    "test:py": "python3 -m unittest discover -s blender -p 'test_*.py'",
    "typecheck": "tsc -p tsconfig.json",
    "bake:sample": "node scripts/bake-sample.mjs"
  },
  "peerDependencies": { "motion": "^14.1.0", "three": "^0.186.0" },
  "peerDependenciesMeta": { "motion": { "optional": true }, "three": { "optional": true } },
  "dependencies": { "vite": "8.3.4" },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "motion": "14.1.0",
    "three": "0.186.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
